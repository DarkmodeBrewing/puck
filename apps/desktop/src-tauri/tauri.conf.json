{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puck",
  "version": "0.0.0",
  "identifier": "dev.darkmodebrewing.puck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Puck", "width": 1100, "height": 760, "minWidth": 600, "minHeight": 480 }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://localhost:1420 ws://localhost:1420" }
  },
  "bundle": { "active": false }
}
